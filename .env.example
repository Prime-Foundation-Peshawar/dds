# Copy to .env on the server (never commit real passwords).

CI_ENVIRONMENT = production

# Staging: https://staging.riphahpsh.edu.pk/dds/
# Production: https://dds.riphahpsh.edu.pk/
app.baseURL = 'https://staging.riphahpsh.edu.pk/dds/'
app.forceGlobalSecureRequests = true
app.indexPage = ''

database.default.hostname = localhost
database.default.database = staging_dds
database.default.username = staging_dds
database.default.password = change_me
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

# ACP bootstrap admin (db/bootstrap_cms.php keeps .env + cms_users in sync on deploy)
CMS_ADMIN_EMAIL = admin@riphahpsh.edu.pk
CMS_ADMIN_PASSWORD = DdsAcp!Staging2026

# Legacy aliases (db/apply.php still reads these)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=staging_dds
DB_USERNAME=staging_dds
DB_PASSWORD=change_me
