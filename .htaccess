DirectoryIndex index.php index.html

# DDS uses PHP 8.4 for CI4 (cPanel EA4). Other sites on the same account are unchanged.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>

RewriteEngine On

# Canonical host: www → non-www (production only)
RewriteCond %{HTTP_HOST} ^www\.dds\.riphahpsh\.edu\.pk$ [NC]
RewriteRule ^(.*)$ https://dds.riphahpsh.edu.pk/$1 [R=301,L]

# Front-controller map into public/
RewriteRule ^(.*)$ public/$1 [L]