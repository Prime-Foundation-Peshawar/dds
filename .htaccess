DirectoryIndex index.php index.html

RewriteEngine On

# Trailing slash removal (relative â€” works at site root and /dds/)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ $1 [R=301,L]

# Extensionless PHP URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L,QSA]

# Redirect direct .php requests to clean URLs (production root only)
RewriteCond %{HTTP_HOST} !^(www\.)?staging\.riphahpsh\.edu\.pk$ [NC]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Staging subdirectory: /dds/page.php -> /dds/page
RewriteCond %{HTTP_HOST} ^(www\.)?staging\.riphahpsh\.edu\.pk$ [NC]
RewriteCond %{THE_REQUEST} \s/dds/(.+?)\.php[\s?] [NC]
RewriteRule ^ /dds/%1 [R=301,L]
